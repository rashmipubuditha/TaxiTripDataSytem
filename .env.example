# Copy to .env (setup.sh does this automatically on first run) and adjust if needed.
# This file is read by bash, Docker Compose and Python: values containing spaces must be in "double quotes".

# --- PostgreSQL (Docker) ---
POSTGRES_USER=taxi
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=taxi_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONTAINER=taxi-postgres
# Docker volume that stores the database files
POSTGRES_VOLUME=taxi_pgdata

# --- Source data ---
# Months to download and process (YYYY-MM, comma-separated).
# Profiles: dev = 2023-01,2023-02 | light = 2023-01..2023-06 | full = 2023-01..2023-12 (default)
MONTHS=2023-01,2023-02,2023-03,2023-04,2023-05,2023-06,2023-07,2023-08,2023-09,2023-10,2023-11,2023-12
# Folder per year; {year} is replaced, e.g. Dataset_2023
RAW_DIR_PATTERN=Dataset_{year}
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net/trip-data
ZONE_LOOKUP_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv
REFERENCE_DIR=reference

# --- ETL processing (optional; these are the defaults) ---
BATCH_SIZE=250000
MAX_DURATION_HOURS=24
MAX_TRIP_DISTANCE_MI=100
MAX_FARE_AMOUNT=1000
# true = verify foreign keys with one set-based check before COMMIT (fast);
# false = let PostgreSQL check every row during the insert (about 6x slower)
FAST_FK_LOAD=true
# Keep rejected source rows (with reason) in data/rejected/<file>_rejected.parquet
SAVE_REJECTED_ROWS=true

# --- Warning checks QC7-QC9 (logged + stored; never block a load) ---
MAX_REJECT_RATE_PCT=4
MAX_DUPLICATE_RATE_PCT=1
MIN_FARE_PER_MILE=3
MAX_FARE_PER_MILE=12

# --- Disk-space checks (GB) ---
# Free space needed in the project folder for downloads.
MIN_FREE_GB_PROJECT=2
# Drive that holds Docker Desktop's disk image (Git Bash path, e.g. /c or /d). Empty = skip check.
DOCKER_DISK_PATH=/c
MIN_FREE_GB_DOCKER=10

# --- Prefect (orchestration) ---
# The pipeline uses this server if it is running (start: bash scripts/start_prefect_server.sh);
# otherwise Prefect runs with a temporary local server and the run still works.
PREFECT_API_URL=http://127.0.0.1:4200/api
# Schedule for `python -m pipeline.flows --serve` (cron; default 06:00 on the 2nd of every month)
SCHEDULE_CRON="0 6 2 * *"
